# VEMO Backend Configuration

# Server
PORT=3001
NODE_ENV=development
SERVICE_NAME=VEMO API

# Database (SQLite for Phase 1)
DATABASE_PATH=./data/vemo.db

# ACE-Step API (private generation engine - never expose directly to browsers)
ACESTEP_API_URL=http://localhost:8001

# Storage
AUDIO_DIR=./public/audio

# Customer-facing frontend
# Production example: https://myvemo.online
FRONTEND_URL=http://localhost:5173
# Optional comma-separated origins for previews/admin tools
FRONTEND_URLS=http://localhost:5173

# Frontend API base used by a Vite client when needed
# Production example: https://api.myvemo.online
VITE_API_URL=http://localhost:3001

# REQUIRED: use a long random value in production
JWT_SECRET=change-me-in-production

# Optional: Pexels API Key (video backgrounds)
PEXELS_API_KEY=
